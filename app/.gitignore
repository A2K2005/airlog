# K-Type free font: personal-use licence only; publishing the repo or APK needs an Enterprise licence (k-type.com/licences)
assets/fonts/SubwayTickerGrid/*.ttf

# Local API keys: never commit
gemini.txt
*.key

# QA debug screenshots (large; kept locally)
docs/screenshots/qa/
