<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window before Android 12 (12+ uses the windowSplashScreen*
     attributes in values-v31): the app's background with the ring mark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/airlog_window_bg" />
    <item
        android:width="160dp"
        android:height="160dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
