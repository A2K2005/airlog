<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash, light: the launcher mark (ring on its
         near-black disc) on the app's light background. Static icon, no
         animated vector. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/airlog_window_bg</item>
        <item name="android:windowSplashScreenBackground">@color/airlog_window_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/airlog_window_bg</item>
    </style>
</resources>
