<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch window (Android 8-11) when the OS dark mode is off: the app's
         light background with the ring mark. Removed when Flutter draws its
         first frame. Android 12+: values-v31. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window colour behind the Flutter UI (and while it initialises): the
         same background as the app, so there is no flash. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/airlog_window_bg</item>
    </style>
</resources>
